return function(t)
	local Profile = t.shared("Profile")
	local Config = t.shared("Config")
	local Rewards = t.shared("Rewards")

	t.test("new profile owns and wears the defaults", function()
		local d = Profile.new()
		t.ok(d.owned.skin_classic and d.owned.trail_mist and d.owned.rewind_ring)
		t.eq(d.equipped.skin, "skin_classic")
		t.eq(d.equipped.trail, "trail_mist")
		t.eq(d.equipped.rewind, "rewind_ring")
		t.eq(d.coins, 0)
		t.eq(d.stars, "")
	end)

	t.test("migrate: garbage, old fields, unknown items, bad stars", function()
		t.eq(Profile.migrate(nil).coins, 0)
		t.eq(Profile.migrate("x").coins, 0)
		local d = Profile.migrate({
			coins = 12.7,
			clears = 4,
			loops = -3,
			stars = "31x9",
			owned = { skin_glass = true, bogus = true },
			equipped = { skin = "trail_pink", trail = "trail_mint", rewind = 5 },
			receipts = { "a", 5 },
		})
		t.eq(d.coins, 12)
		t.eq(d.clears, 4)
		t.eq(d.loops, 0)
		t.eq(d.stars, "3100")
		t.ok(d.owned.skin_glass and not d.owned.bogus)
		t.eq(d.equipped.skin, "skin_classic", "wrong kind falls back")
		t.eq(d.equipped.trail, "trail_mint")
		t.eq(d.equipped.rewind, "rewind_ring")
		t.eq(#d.receipts, 1)
	end)

	t.test("stars: best result kept, unlocking, next level", function()
		local d = Profile.new()
		t.ok(Profile.unlocked(d, 1) and not Profile.unlocked(d, 2))
		t.eq(Profile.nextLevel(d, 30), 1)
		local first, gained = Profile.recordClear(d, 1, 2)
		t.ok(first and gained == 2)
		t.ok(Profile.unlocked(d, 2) and not Profile.unlocked(d, 3))
		first, gained = Profile.recordClear(d, 1, 1)
		t.ok(not first and gained == 0, "worse result keeps the stars")
		t.eq(Profile.starsOf(d, 1), 2)
		first, gained = Profile.recordClear(d, 1, 3)
		t.ok(not first and gained == 1)
		Profile.recordClear(d, 3, 1)
		t.eq(d.stars, "301")
		t.eq(Profile.totalStars(d), 4)
		t.eq(Profile.nextLevel(d, 30), 2)
		t.ok(Profile.unlocked(d, 4), "a cleared level opens the next one")
		t.eq(d.clears, 4)
		t.eq(d.perfects, 1)
	end)

	t.test("duplicates refund coins", function()
		local d = Profile.new()
		t.ok(not Profile.grantItem(d, "skin_glass").dup)
		local b = Profile.grantItem(d, "skin_glass")
		t.ok(b.dup)
		t.eq(b.refund, Config.Rarity.Common.refund)
		t.eq(d.coins, Config.Rarity.Common.refund)
	end)

	t.test("buying with coins", function()
		local d = Profile.new()
		local ok, err = Profile.buyWithCoins(d, "skin_glass")
		t.ok(not ok and err == "shop.noCoins")
		d.coins = 1000
		t.ok((Profile.buyWithCoins(d, "skin_glass")))
		t.eq(d.coins, 1000 - Config.Rarity.Common.price)
		ok, err = Profile.buyWithCoins(d, "skin_glass")
		t.ok(not ok and err == "shop.owned")
		ok, err = Profile.buyWithCoins(d, "skin_gold")
		t.ok(not ok and err == "shop.notForSale")
		ok, err = Profile.buyWithCoins(d, "trail_mist")
		t.ok(not ok and err == "shop.notForSale", "defaults are not for sale")
	end)

	t.test("equip rules and VIP items", function()
		local d = Profile.new()
		t.ok(not Profile.equip(d, "skin_glass", false), "not owned")
		t.ok(not Profile.equip(d, "skin_gold", false), "VIP without pass")
		t.ok(Profile.equip(d, "skin_gold", true), "VIP with pass")
		t.ok(Profile.equip(d, "trail_gold", true))
		t.eq(Profile.effective(d, "skin", true), "skin_gold")
		t.eq(Profile.effective(d, "skin", false), "skin_classic", "pass gone → default")
		t.eq(Profile.effective(d, "trail", false), "trail_mist")
		t.eq(Profile.effective(d, "rewind", false), "rewind_ring")
	end)

	t.test("direct purchase picks the wanted item or any missing one", function()
		local d = Profile.new()
		t.eq(Profile.pickDirect(d, "Epic", "skin_hologram"), "skin_hologram")
		t.ok(Profile.pickDirect(d, "Epic", "skin_glass") ~= "skin_glass", "wrong rarity ignored")
		d.owned.skin_hologram = true
		t.ok(Profile.pickDirect(d, "Epic", "skin_hologram") ~= "skin_hologram", "owned → another one")
		d.owned.skin_prism = true
		d.owned.rewind_galaxy = true
		t.eq(Profile.pickDirect(d, "Legendary", nil), nil, "all owned")
	end)

	t.test("receipt log is bounded and idempotent", function()
		local d = Profile.new()
		for i = 1, Config.DataStore.ReceiptLog + 20 do
			Profile.addReceipt(d, "p" .. i)
		end
		t.eq(#d.receipts, Config.DataStore.ReceiptLog)
		t.ok(not Profile.hasReceipt(d, "p1"))
		t.ok(Profile.hasReceipt(d, "p" .. (Config.DataStore.ReceiptLog + 20)))
	end)

	t.test("earned coins", function()
		local d = Profile.new()
		Profile.earn(d, 40)
		Profile.earn(d, -5)
		t.eq(d.coins, 40)
		t.eq(d.earned, 40)
	end)

	t.test("rewards: stars, level coins, passes multiply", function()
		t.eq(Rewards.stars({ loopsPlayed = 3, loopsNeeded = 3 }), 3)
		t.eq(Rewards.stars({ loopsPlayed = 4, loopsNeeded = 3 }), 2, "a retried loop")
		t.eq(Rewards.stars({ loopsPlayed = 3, loopsNeeded = 3, undone = true }), 2)
		t.eq(Rewards.stars({ loopsPlayed = 3, loopsNeeded = 3, hinted = true }), 1)
		t.eq(Rewards.stars({ loopsPlayed = 4, loopsNeeded = 3, extra = true }), 1)
		local R = Config.Rewards
		t.eq(Rewards.levelCoins(3, true, 3), R.FirstBase + 3 * R.FirstPerK + 3 * R.StarBonus)
		t.eq(Rewards.levelCoins(3, false, 0), R.Repeat)
		t.eq(Rewards.multiplier(false, false), 1)
		t.near(Rewards.multiplier(true, true), 2.2, 1e-9)
		t.eq(Rewards.apply(35, 1.1), 38)
		t.eq(Rewards.apply(10, 1.1), 11, "no float error")
	end)
end
